# DonMir Boot Agent Environment Configuration Example
# ВНИМАНИЕ: Настоящие ключи указываются в файле .env (он заблокирован гитом).

# Основные настройки приложения
APP_NAME="DonMir Boot Agent"
APP_ENV="development"        # development / production / testing
DEBUG=true
LOG_LEVEL="INFO"             # DEBUG / INFO / WARNING / ERROR

# Сетевые настройки
HOST="0.0.0.0"
PORT=8000

# Идентификация и безопасность владельца
OWNER_ID="donmir_owner"
API_SECRET_KEY="replace_with_your_secure_secret_key"
