# Переменные окружения и секреты (КРАЙНЕ ВАЖНО)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Временные файлы Python и кэш
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Виртуальное окружение Python
venv/
.venv/
env/
ENV/

# Файлы операционных систем и IDE
.DS_Store
.vscode/
.idea/
*.swp
*~

# Логи и временные хранилища
logs/*.log
!logs/.gitkeep
storage/*
!storage/.gitkeep
